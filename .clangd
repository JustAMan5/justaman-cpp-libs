CompileFlags:
    Compiler: C:/msys64/ucrt64/bin/g++.exe
    Add:
        - -std=c++26
        - -isystem
        - C:/msys64/ucrt64/include/c++/v1

---

If:
    PathMatch: .*\.tcc

CompileFlags:
    Add: [-x, c++]

---

If:
    PathMatch: libs/cpp20/.*

CompileFlags:
    Add: [-std=c++20]

---

If:
    PathMatch: libs/cpp23/.*

CompileFlags:
    Add: [-std=c++23]

---

If:
    PathMatch: libs/cpp26/.*

CompileFlags:
    Add: [-std=c++26]