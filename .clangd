# setting up the standard

If:
    PathMatch: libs/cpp20/.*
CompileFlags:
    Add: [-std=c++20]
---

If:
    PathMatch: libs/cpp23/.*
CompileFlags:
    Add: [-std=c++23]
---
If:
    PathMatch: libs/cpp26/.*
CompileFlags:
    Add: [-std=c++26]
---
# --- Windows-specific blocks ---

# fix this shit not working on mingw
CompileFlags:
    Compiler: C:/msys64/ucrt64/bin/g++.exe
    Add:
        - -isystem
        - C:/msys64/ucrt64/include/c++/v1